{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"rootDir": "./src",
		"baseUrl": "./src"
	},
	"include": ["./src/**/*.ts", "./src/**/*.tsx"],
	"exclude": ["./src/**/*.spec.ts", "./src/**/*.spec.tsx"]
}
