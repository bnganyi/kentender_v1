{
  "$id": "bwmf/v1/source_binding",
  "schema_version": "1.0.0",
  "title": "SourceBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "binding_type",
    "object_ref",
    "object_version",
    "lifecycle_state",
    "document_content_digest"
  ],
  "properties": {
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "binding_type": {
      "type": "string",
      "minLength": 1
    },
    "object_ref": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "type": [
        "string",
        "integer"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "approved",
        "published",
        "draft",
        "superseded"
      ]
    },
    "archive_provenance_digest": {
      "type": "string",
      "format": "sha256-digest",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "document_content_digest": {
      "type": "string",
      "format": "sha256-digest",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compatibility_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declared_compatible_with": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
