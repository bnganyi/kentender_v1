  "rules": {
    "template_code": "KE-PPRA-WORKS-BLDG-2022-04-POC",
    "rule_model_version": "0.1.0-poc",
    "rule_types": [
      {
        "code": "REQUIRE_FIELD",
        "label": "Require Field",
        "description": "Requires one or more fields to have values when the rule condition applies."
      },
      {
        "code": "REQUIRE_CHILD_ROWS",
        "label": "Require Child Rows",
        "description": "Requires one or more child table rows when the rule condition applies."
      },
      {
        "code": "ACTIVATE_FIELD",
        "label": "Activate Field",
        "description": "Marks fields as active or relevant when the rule condition applies."
      },
      {
        "code": "ACTIVATE_SECTION",
        "label": "Activate Section",
        "description": "Marks sections as active or relevant when the rule condition applies."
      },
      {
        "code": "ACTIVATE_FORM",
        "label": "Activate Form",
        "description": "Marks bidder or contract forms as required when the rule condition applies."
      },
      {
        "code": "DERIVE_FIELD",
        "label": "Derive Field",
        "description": "Derives a field value from another field or condition."
      },
      {
        "code": "VALIDATE_DATE_ORDER",
        "label": "Validate Date Order",
        "description": "Validates chronological ordering between date or datetime fields."
      },
      {
        "code": "VALIDATE_NUMERIC_LIMIT",
        "label": "Validate Numeric Limit",
        "description": "Validates numeric or monetary values against a configured limit."
      },
      {
        "code": "VALIDATE_ALLOWED_COMBINATION",
        "label": "Validate Allowed Combination",
        "description": "Validates that a combination of field values is permitted."
      },
      {
        "code": "WARNING_ONLY",
        "label": "Warning Only",
        "description": "Produces a warning without blocking generation."
      },
      {
        "code": "INFO_ONLY",
        "label": "Information Only",
        "description": "Produces informational output without blocking generation."
      }
    ],
    "message_severities": [
      {
        "code": "INFO",
        "label": "Info",
        "blocks_generation": false
      },
      {
        "code": "WARNING",
        "label": "Warning",
        "blocks_generation": false
      },
      {
        "code": "ERROR",
        "label": "Error",
        "blocks_generation": true
      },
      {
        "code": "BLOCKER",
        "label": "Blocker",
        "blocks_generation": true
      }
    ],
    "operator_definitions": [
      {
        "code": "EQUALS",
        "description": "Field value equals expected value."
      },
      {
        "code": "NOT_EQUALS",
        "description": "Field value does not equal expected value."
      },
      {
        "code": "IS_TRUE",
        "description": "Boolean field is true."
      },
      {
        "code": "IS_FALSE",
        "description": "Boolean field is false."
      },
      {
        "code": "IS_EMPTY",
        "description": "Field value is null, empty string, or empty list."
      },
      {
        "code": "IS_NOT_EMPTY",
        "description": "Field value exists and is not empty."
      },
      {
        "code": "GREATER_THAN",
        "description": "Numeric or date value is greater than comparison value."
      },
      {
        "code": "GREATER_THAN_OR_EQUALS",
        "description": "Numeric or date value is greater than or equal to comparison value."
      },
      {
        "code": "LESS_THAN",
        "description": "Numeric or date value is less than comparison value."
      },
      {
        "code": "LESS_THAN_OR_EQUALS",
        "description": "Numeric or date value is less than or equal to comparison value."
      },
      {
        "code": "IN",
        "description": "Field value exists in a supplied list."
      },
      {
        "code": "NOT_IN",
        "description": "Field value does not exist in a supplied list."
      }
    ],
    "rules": [
      {
        "rule_code": "RULE_REQUIRED_CORE_TENDER_IDENTITY",
        "rule_type": "REQUIRE_FIELD",
        "label": "Require core tender identity fields",
        "description": "A tender cannot be generated without core tender identity information.",
        "enabled": true,
        "severity": "BLOCKER",
        "when": {
          "all": []
        },
        "then": {
          "require_fields": [
            "TENDER.PROCURING_ENTITY_NAME",
            "TENDER.PROCURING_ENTITY_ADDRESS",
            "TENDER.PROCURING_ENTITY_EMAIL",
            "TENDER.TENDER_NAME",
            "TENDER.TENDER_REFERENCE",
            "TENDER.CONTRACT_DESCRIPTION",
            "TENDER.WORKS_LOCATION",
            "TENDER.ESTIMATED_COST"
          ],
          "require_child_rows": [],
          "activate_fields": [],
          "activate_sections": [
            "COVER",
            "INVITATION_TO_TENDER"
          ],
          "activate_forms": [],
          "derive_fields": [],
          "validate": []
        },
        "message": "Core tender identity fields must be completed before generating the tender pack.",
        "affected_sections": [
          "COVER",
          "INVITATION_TO_TENDER"
        ],
        "affected_fields": [
          "TENDER.PROCURING_ENTITY_NAME",
          "TENDER.PROCURING_ENTITY_ADDRESS",
          "TENDER.PROCURING_ENTITY_EMAIL",
          "TENDER.TENDER_NAME",
          "TENDER.TENDER_REFERENCE",
          "TENDER.CONTRACT_DESCRIPTION",
          "TENDER.WORKS_LOCATION",
          "TENDER.ESTIMATED_COST"
        ],
        "affected_forms": [],
        "notes": []
      },
      {
        "rule_code": "RULE_REQUIRE_METHOD_AND_SCOPE",
        "rule_type": "REQUIRE_FIELD",
        "label": "Require procurement method and tender scope",
        "description": "The procurement method and tender scope determine downstream scenario activation.",
        "enabled": true,
        "severity": "BLOCKER",
        "when": {
          "all": []
        },
        "then": {
          "require_fields": [
            "METHOD.PROCUREMENT_METHOD",
            "METHOD.TENDER_SCOPE"
          ],
          "require_child_rows": [],
          "activate_fields": [],
          "activate_sections": [
            "INVITATION_TO_TENDER",
            "TDS"
          ],
          "activate_forms": [],
          "derive_fields": [],
          "validate": []
        },
        "message": "Procurement method and tender scope are required.",
        "affected_sections": [
          "INVITATION_TO_TENDER",
          "TDS"
        ],
        "affected_fields": [
          "METHOD.PROCUREMENT_METHOD",
          "METHOD.TENDER_SCOPE"
        ],
        "affected_forms": [],
        "notes": []
      },
      {
        "rule_code": "RULE_INTERNATIONAL_ACTIVATE_FOREIGN_TENDERER_LOCAL_INPUT",
        "rule_type": "ACTIVATE_FIELD",
        "label": "Activate foreign tenderer local input rule for international tenders",
        "description": "International tenders should expose the foreign tenderer local input configuration and related form.",
        "enabled": true,
        "severity": "INFO",
        "when": {
          "all": [
            {
              "field": "METHOD.TENDER_SCOPE",
              "operator": "EQUALS",
              "value": "INTERNATIONAL"
            }
          ]
        },
        "then": {
          "require_fields": [],
          "require_child_rows": [],
          "activate_fields": [
            "PARTICIPATION.FOREIGN_TENDERER_LOCAL_INPUT_RULE_APPLICABLE"
          ],
          "activate_sections": [
            "TDS",
            "TENDERING_FORMS"
          ],
          "activate_forms": [
            "FORM_FOREIGN_TENDERER_LOCAL_INPUT"
          ],
          "derive_fields": [
            {
              "field": "PARTICIPATION.FOREIGN_TENDERER_LOCAL_INPUT_RULE_APPLICABLE",
              "value": true,
              "mode": "SUGGEST_OR_SET"
            }
          ],
          "validate": []
        },
        "message": "International tendering activates foreign tenderer local input configuration and form requirements.",
        "affected_sections": [
          "TDS",
          "TENDERING_FORMS"
        ],
        "affected_fields": [
          "METHOD.TENDER_SCOPE",
          "PARTICIPATION.FOREIGN_TENDERER_LOCAL_INPUT_RULE_APPLICABLE"
        ],
        "affected_forms": [
          "FORM_FOREIGN_TENDERER_LOCAL_INPUT"
        ],
        "notes": [
          "The engine may set the field automatically or flag it as active depending on implementation choice."
        ]
