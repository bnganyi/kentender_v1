  "forms": {
    "template_code": "KE-PPRA-WORKS-BLDG-2022-04-POC",
    "form_model_version": "0.1.0-poc",
    "form_categories": [
      {
        "code": "CORE_BID_SUBMISSION",
        "label": "Core Bid Submission",
        "description": "Core forms required for most bid submissions."
      },
      {
        "code": "ELIGIBILITY_DECLARATION",
        "label": "Eligibility Declaration",
        "description": "Declarations regarding eligibility, corruption, conflict, independence, or statutory status."
      },
      {
        "code": "SECURITY_INSTRUMENT",
        "label": "Security Instrument",
        "description": "Tender security or tender-securing declaration forms."
      },
      {
        "code": "PARTICIPATION_STRUCTURE",
        "label": "Participation Structure",
        "description": "Forms related to joint ventures, foreign tenderer participation, or local input commitments."
      },
      {
        "code": "QUALIFICATION_EVIDENCE",
        "label": "Qualification Evidence",
        "description": "Forms related to experience, finance, personnel, equipment, or qualifications."
      },
      {
        "code": "TECHNICAL_PROPOSAL",
        "label": "Technical Proposal",
        "description": "Forms related to methodology, technical proposal, alternatives, ESHS, or works execution approach."
      },
      {
        "code": "OWNERSHIP_DISCLOSURE",
        "label": "Ownership Disclosure",
        "description": "Beneficial ownership or ownership/control disclosure forms."
      },
      {
        "code": "CONTRACT_SECURITY",
        "label": "Contract Security",
        "description": "Forms generated or required after award or before contract signature."
      },
      {
        "code": "DOWNSTREAM_CONTRACT_FORM",
        "label": "Downstream Contract Form",
        "description": "Contract forms that are downstream from bid submission."
      }
    ],
    "respondent_types": [
      {
        "code": "BIDDER",
        "label": "Bidder",
        "description": "Form is completed by the tenderer or bidder during bid submission."
      },
      {
        "code": "BIDDER_OR_JV",
        "label": "Bidder or Joint Venture",
        "description": "Form is completed by an individual bidder or joint venture."
      },
      {
        "code": "JOINT_VENTURE",
        "label": "Joint Venture",
        "description": "Form is completed only when a joint venture participates."
      },
      {
        "code": "FOREIGN_TENDERER",
        "label": "Foreign Tenderer",
        "description": "Form is completed when foreign tenderer or local input requirements apply."
      },
      {
        "code": "SUCCESSFUL_BIDDER",
        "label": "Successful Bidder",
        "description": "Form is completed only by the successful bidder after award or before contract signing."
      },
      {
        "code": "PROCURING_ENTITY",
        "label": "Procuring Entity",
        "description": "Form or generated record belongs to the procuring entity."
      },
      {
        "code": "SYSTEM_GENERATED",
        "label": "System Generated",
        "description": "Form or checklist item is generated by the system from workflow data."
      }
    ],
    "workflow_stages": [
      {
        "code": "BID_PREPARATION",
        "label": "Bid Preparation",
        "description": "Form is visible to bidder before submission."
      },
      {
        "code": "BID_SUBMISSION",
        "label": "Bid Submission",
        "description": "Form is part of the bid submission package."
      },
      {
        "code": "EVALUATION",
        "label": "Evaluation",
        "description": "Form supports evaluation or post-qualification."
      },
      {
        "code": "AWARD",
        "label": "Award",
        "description": "Form is used at intention-to-award or award stage."
      },
      {
        "code": "CONTRACT_SIGNATURE",
        "label": "Contract Signature",
        "description": "Form is required before or during contract signature."
      },
      {
        "code": "CONTRACT_EXECUTION",
        "label": "Contract Execution",
        "description": "Form is relevant after contract signature."
      },
      {
        "code": "POC_CHECKLIST_ONLY",
        "label": "POC Checklist Only",
        "description": "Form is represented only as a checklist item in this POC."
      }
    ],
    "evidence_policies": [
      {
        "code": "STRUCTURED_ONLY",
        "label": "Structured Only",
        "description": "Form should be completed as structured fields; no routine upload expected."
      },
      {
        "code": "STRUCTURED_WITH_OPTIONAL_EVIDENCE",
        "label": "Structured With Optional Evidence",
        "description": "Form is structured but may later allow controlled evidence attachments."
      },
      {
        "code": "STRUCTURED_WITH_REQUIRED_EVIDENCE_LATER",
        "label": "Structured With Required Evidence Later",
        "description": "Form is structured at bid stage; evidence may be required later for verification."
      },
      {
        "code": "ISSUER_VERIFICATION_FUTURE",
        "label": "Issuer Verification Future",
        "description": "Instrument should later be verified through issuer, bank, or insurer workflow rather than scanned upload."
      },
      {
        "code": "GENERATED_AFTER_AWARD",
        "label": "Generated After Award",
        "description": "Form is generated later from award or contract data."
      },
      {
        "code": "POC_CHECKLIST_ONLY",
        "label": "POC Checklist Only",
        "description": "POC only records the form as required or not required."
      }
